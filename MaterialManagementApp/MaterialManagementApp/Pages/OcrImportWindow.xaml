<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MaterialManagementApp.Pages.OcrImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="导入单据 / OCR 识别">

    <!-- 非模态窗口：上半部分为单据图片区（预览 + 拖拽），下半部分为识别结果区（字段 + 全文 + 进度） -->
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="导入单据 / OCR 识别" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="内嵌离线 OCR 引擎（PaddleOCR PP-OCRv6），图片与识别结果全部留在本机、不联网。支持把图片拖入下方区域，或使用「粘贴」「截屏」。"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 上半部分：图片预览与拖拽投放区 -->
        <Border
            Grid.Row="1"
            CornerRadius="8"
            AllowDrop="True"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppCardStrokeBrush}"
            BorderThickness="1"
            DragOver="OnDropAreaDragOver"
            Drop="OnDropAreaDrop">
            <Grid>
                <TextBlock
                    x:Name="PreviewHint"
                    Text="把单据图片拖到这里，或点击下方「选择图片」/「粘贴」/「截屏」"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Image x:Name="PreviewImage" Margin="8" Stretch="Uniform" />
            </Grid>
        </Border>

        <!-- 图片来源按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="PickImageButton"
                Content="选择图片"
                Click="OnPickImageClick"
                Style="{ThemeResource AccentButtonStyle}" />
            <Button x:Name="PasteButton" Content="粘贴" Click="OnPasteClick">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="V" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="CaptureButton" Content="截屏" Click="OnCaptureClick" />
            <Button Content="清空" Click="OnClearClick" />
        </StackPanel>

        <!-- 进度与状态 -->
        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressBar x:Name="OcrProgress" Value="0" />
            <TextBlock
                x:Name="StatusText"
                Text="请选择、拖入或粘贴一张单据图片开始识别。"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 下半部分：正则抽取出的字段，便于快速比对录入 -->
        <GridView
            x:Name="FieldList"
            Grid.Row="4"
            IsItemClickEnabled="False"
            SelectionMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" ItemHeight="32" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock
                            Width="76"
                            Text="{Binding Label}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Value}" TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 识别全文与「复制全部」 -->
        <Grid Grid.Row="5" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="识别全文"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Button
                    x:Name="FillButton"
                    Grid.Column="1"
                    Content="填入表格"
                    Click="OnFillClick"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="False" />
                <Button
                    Grid.Column="2"
                    Content="复制全部"
                    Click="OnCopyAllClick" />
            </Grid>

            <TextBox
                x:Name="RawTextBox"
                Grid.Row="1"
                AcceptsReturn="True"
                IsReadOnly="True"
                TextWrapping="Wrap"
                PlaceholderText="识别结果会显示在这里"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
