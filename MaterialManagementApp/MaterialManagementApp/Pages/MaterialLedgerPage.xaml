<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.MaterialLedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaterialManagementApp.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 新增行的「取消」与已有行的「删除」按 IsNewRow 互斥显示 -->
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 表格空态：记录数为 0 时显示引导提示 -->
        <common:CountToVisibilityConverter x:Key="CountToVisibility" />
        <!-- 状态提示条：有消息时才显示容器 -->
        <common:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <!-- 上下分栏：第 1~2 行为查询与操作区（紧凑），第 3 行为数据列表（占满剩余高度） -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="台账明细" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 上半部分：查询筛选面板。点击「查询」按条件重新加载，点击「重置」清空条件 -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- DatePicker.Date 是 DateTimeOffset，而筛选属性是可空 DateTimeOffset?，
                     x:Bind 不接受这种可空收窄，因此这里用经典 Binding 由运行时转换 -->
                <DatePicker
                    Grid.Column="0"
                    Header="开始日期"
                    MinWidth="140"
                    Date="{Binding StartDate, Mode=TwoWay}" />
                <DatePicker
                    Grid.Column="1"
                    Header="结束日期"
                    MinWidth="140"
                    Date="{Binding EndDate, Mode=TwoWay}" />
                <!-- SelectedItem 为 object，同样用经典 Binding 完成 object 到 string 的转换 -->
                <ComboBox
                    Grid.Column="2"
                    Header="物资名称"
                    MinWidth="160"
                    ItemsSource="{x:Bind ViewModel.MaterialNameOptions, Mode=OneWay}"
                    SelectedItem="{Binding SelectedMaterialName, Mode=TwoWay}" />
                <Button
                    Grid.Column="3"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="4"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
                <ctrl:DeptPhaseFilterBar
                    x:Name="DeptPhaseFilter"
                    Grid.Column="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    SelectedDept="{Binding SelectedDept, Mode=TwoWay}"
                    SelectedPhase="{Binding SelectedPhase, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- 下半部分：表格上方的操作按钮。「新增」直接在表格首行插入空白行，不再弹出录入表单 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新增" Click="OnNewRowClick" />
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadCommand}" />
                <Button Content="按模板导出" Click="OnExportTemplateClick" />
                <Button Content="导入单据 / OCR 识别" Click="OnOcrImportClick" />
            </StackPanel>
            <!-- 状态提示条：有消息才显示，浅灰容器与卡片语言一致 -->
            <Border
                Padding="12,7"
                CornerRadius="4"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- 表格区：单元格可编辑，金额列为只读的派生值；行末按行状态显示保存/删除或保存/取消。
             无数据时叠加居中空态提示（记录数为 0 时显示，新增/删除行即时切换） -->
        <Grid Grid.Row="3">
            <controls:DataGrid
                x:Name="LedgerGrid"
                AutoGenerateColumns="False"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="False"
            SelectionMode="Single"
            SelectionChanged="OnLedgerSelectionChanged"
            ItemsSource="{x:Bind ViewModel.Ledgers, Mode=OneWay}">
            <controls:DataGrid.Columns>
                <!-- 列顺序与名称严格对齐「地材台账模版」的 12 列表头（序号不入表格，由导出时生成） -->
                <controls:DataGridTextColumn
                    Binding="{Binding EntryDate, Mode=TwoWay}"
                    Header="入库日期" />
                <controls:DataGridTextColumn
                    Binding="{Binding DocNo, Mode=TwoWay}"
                    Header="编号" />
                <!-- 商品名称是行内保存的唯一硬校验字段，列头星号标识必填。
                     注意：Toolkit DataGrid 列头是 ContentControl，只支持纯文本或
                     ContentTemplate，直接放 StackPanel 等 UIElement 会抛
                     NotSupportedException（应用启动即闪退），必须用文本列头 -->
                <controls:DataGridTextColumn
                    Binding="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="商品名称 *" />
                <controls:DataGridTextColumn
                    Binding="{Binding Specification, Mode=TwoWay}"
                    Header="商品规格" />
                <controls:DataGridTextColumn
                    Binding="{Binding Unit, Mode=TwoWay}"
                    Header="单位" />
                <controls:DataGridTextColumn
                    Binding="{Binding Quantity, Mode=TwoWay}"
                    Header="数量" />
                <controls:DataGridTextColumn
                    Binding="{Binding UnitPrice, Mode=TwoWay}"
                    Header="单价" />
                <controls:DataGridTextColumn
                    Binding="{Binding Amount, Mode=OneWay}"
                    Header="金额"
                    IsReadOnly="True" />
                <controls:DataGridTextColumn
                    Binding="{Binding Handler, Mode=TwoWay}"
                    Header="经办人" />
                <controls:DataGridTextColumn
                    Binding="{Binding ProjectAddress, Mode=TwoWay}"
                    Header="收货位置" />
                <controls:DataGridTemplateColumn Header="项目部">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProjectDept}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ctrl:DeptPicker Value="{Binding ProjectDept, Mode=TwoWay}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="期数">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProjectPhase}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ctrl:PhasePicker Value="{Binding ProjectPhase, Mode=TwoWay}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn
                    Binding="{Binding Remark, Mode=TwoWay}"
                    Header="备注" />
                <!-- 行内操作列：模板列内按钮的 DataContext 就是该行数据，因此用 Click 事件处理 -->
                <controls:DataGridTemplateColumn Header="操作">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- 保存：空白新增行执行入库，已有行执行更新 -->
                                <Button Content="保存" Click="OnSaveRowClick" />
                                <!-- 删除：仅已入库的行显示 -->
                                <Button
                                    Content="删除"
                                    Click="OnDeleteRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <!-- 取消：仅尚未入库的新增行显示，点击后直接移除该行 -->
                                <Button
                                    Content="取消"
                                    Click="OnCancelNewRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 空态：表格无数据时显示，居中不遮挡表头；新增行后即时隐藏 -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.Ledgers.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
            <FontIcon
                Glyph="&#xE719;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="44"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="暂无台账记录"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="点击上方「新增」录入第一条记录，或使用「导入单据 / OCR 识别」批量导入。"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>

        <!-- 合计行：固定在表格最下方，金额合计按 Σ(数量×单价) 现算 -->
        <Border
            Grid.Row="4"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="合计"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="0,0,24,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="数量合计："
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.TotalQuantity, Mode=OneWay}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="金额合计："
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="元"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <ctrl:PagerBar
            Grid.Row="5"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />
    </Grid>
</Page>
