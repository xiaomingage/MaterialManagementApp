<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.MaterialLedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaterialManagementApp.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 已入库行的「删除」按钮与地材单图片「查看」按状态显隐 -->
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 表格空态：记录数为 0 时显示引导提示 -->
        <common:CountToVisibilityConverter x:Key="CountToVisibility" />
        <!-- 状态提示条：有消息时才显示容器 -->
        <common:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <!-- 上下分栏：第 1~2 行为查询与操作区（紧凑），第 3 行为数据列表（占满剩余高度） -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="台账明细" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 上半部分：查询筛选面板。点击「查询」按条件重新加载，点击「重置」清空条件 -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- DatePicker.Date 是 DateTimeOffset，而筛选属性是可空 DateTimeOffset?，
                     x:Bind 不接受这种可空收窄，因此这里用经典 Binding 由运行时转换 -->
                <DatePicker
                    Grid.Column="0"
                    Header="开始日期"
                    MinWidth="140"
                    Date="{Binding StartDate, Mode=TwoWay}" />
                <DatePicker
                    Grid.Column="1"
                    Header="结束日期"
                    MinWidth="140"
                    Date="{Binding EndDate, Mode=TwoWay}" />
                <!-- SelectedItem 为 object，同样用经典 Binding 完成 object 到 string 的转换 -->
                <ComboBox
                    Grid.Column="2"
                    Header="物资名称"
                    MinWidth="160"
                    ItemsSource="{x:Bind ViewModel.MaterialNameOptions, Mode=OneWay}"
                    SelectedItem="{Binding SelectedMaterialName, Mode=TwoWay}" />
                <Button
                    Grid.Column="3"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="4"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
                <ctrl:DeptPhaseFilterBar
                    x:Name="DeptPhaseFilter"
                    Grid.Column="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    SelectedDept="{Binding SelectedDept, Mode=TwoWay}"
                    SelectedPhase="{Binding SelectedPhase, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- 表格上方的操作按钮。「保存」批量入库表格中的全部草稿行（浅绿底）；
             新增不再需要按钮——点击表格空白处即自动插入草稿行 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Content="保存"
                    Command="{x:Bind ViewModel.SaveAllDraftsCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshGuardedCommand}" />
                <Button Content="按模板导出" Click="OnExportTemplateClick" />
                <Button Content="导入单据 / OCR 识别" Click="OnOcrImportClick" />
                <Button Content="批量扫描识别" Click="OnBatchOcrImportClick" />
                <!-- 勾选行后出现：批量修改项目部/期数/经办人，或批量删除（均可撤销） -->
                <Button
                    Content="批量修改"
                    Click="OnBatchUpdateClick"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.HasCheckedRows, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Content="删除选中"
                    Click="OnDeleteCheckedClick"
                    Visibility="{x:Bind ViewModel.HasCheckedRows, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <!-- 状态提示条：有消息才显示，浅灰容器与卡片语言一致 -->
            <Border
                Padding="12,7"
                CornerRadius="4"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- 表格区：单元格可编辑，金额列为只读的派生值。
             交互约定：点击表格空白处即插入草稿行（DataGridQuickAdd 行为，见 code-behind）；
             已入库的行离开编辑即自动保存；草稿行由上方「保存」批量入库；行末仅保留「删除」。
             无数据时叠加居中空态提示（记录数为 0 时显示，新增/删除行即时切换） -->
        <Grid Grid.Row="3">
            <controls:DataGrid
                x:Name="LedgerGrid"
                AutoGenerateColumns="False"
            Background="Transparent"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="False"
            SelectionMode="Single"
            SelectionChanged="OnLedgerSelectionChanged"
            RowEditEnded="OnLedgerRowEditEnded"
            LoadingRow="OnLedgerLoadingRow"
            ItemsSource="{x:Bind ViewModel.Ledgers, Mode=OneWay}">
            <!-- 右键表格弹出「显示/隐藏列」配置菜单（动态生成，见 code-behind）；
                 列宽拖动由 DataGrid 默认 CanUserResizeColumns 支持 -->
            <controls:DataGrid.ContextFlyout>
                <MenuFlyout Opening="OnColumnMenuOpening" Placement="Bottom" />
            </controls:DataGrid.ContextFlyout>
            <controls:DataGrid.Columns>
                <!-- 最左侧勾选列：勾选多行后顶部出现「批量修改 / 删除选中」 -->
                <controls:DataGridTemplateColumn CanUserResize="False" CanUserReorder="False">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                MinWidth="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                Click="OnRowCheckClick" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <!-- 列顺序与名称严格对齐「地材台账模版」的 12 列表头（序号不入表格，由导出时生成） -->
                <controls:DataGridTextColumn
                    Binding="{Binding EntryDate, Mode=TwoWay}"
                    Header="入库日期" />
                <controls:DataGridTextColumn
                    Binding="{Binding DocNo, Mode=TwoWay}"
                    Header="编号" />
                <!-- 商品名称是行内保存的唯一硬校验字段，列头星号标识必填。
                     编辑时使用 AutoSuggestBox：防抖查询历史名称给出联想下拉（见 code-behind）。
                     注意：Toolkit DataGrid 列头是 ContentControl，只支持纯文本，
                     直接放 UIElement 会抛 NotSupportedException（启动即闪退） -->
                <controls:DataGridTemplateColumn Header="商品名称 *">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MaterialName}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <AutoSuggestBox
                                Text="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnMaterialNameSuggestText"
                                QueryIcon="Find" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn
                    Binding="{Binding Specification, Mode=TwoWay}"
                    Header="商品规格" />
                <controls:DataGridTextColumn
                    Binding="{Binding Unit, Mode=TwoWay}"
                    Header="单位" />
                <controls:DataGridTextColumn
                    Binding="{Binding Quantity, Mode=TwoWay}"
                    Header="数量" />
                <controls:DataGridTextColumn
                    Binding="{Binding UnitPrice, Mode=TwoWay}"
                    Header="单价" />
                <controls:DataGridTextColumn
                    Binding="{Binding Amount, Mode=OneWay}"
                    Header="金额"
                    IsReadOnly="True" />
                <!-- 经办人：编辑时同样走历史姓名联想 -->
                <controls:DataGridTemplateColumn Header="经办人">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Handler}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <AutoSuggestBox
                                Text="{Binding Handler, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnHandlerSuggestText" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn
                    Binding="{Binding ProjectAddress, Mode=TwoWay}"
                    Header="收货位置" />
                <controls:DataGridTemplateColumn Header="项目部">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProjectDept}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ctrl:DeptPicker Value="{Binding ProjectDept, Mode=TwoWay}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="期数">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProjectPhase}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ctrl:PhasePicker Value="{Binding ProjectPhase, Mode=TwoWay}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn
                    Binding="{Binding Remark, Mode=TwoWay}"
                    Header="备注" />
                <!-- 地材单图片列：批量扫描识别保存时自动关联图片，点击「查看」打开大图 -->
                <controls:DataGridTemplateColumn Header="地材单图片">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Content="查看"
                                Click="OnViewLedgerImageClick"
                                Padding="12,2"
                                Visibility="{Binding HasLedgerImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                ToolTipService.ToolTip="{Binding LedgerImagePath}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <!-- 行内操作列：模板列内按钮的 DataContext 就是该行数据，因此用 Click 事件处理。
                     保存动作统一由上方「保存」按钮承担，行末只保留「删除」；
                     未入库的草稿行删除时直接移除，已入库行删除前二次确认 -->
                <controls:DataGridTemplateColumn Header="操作">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Content="删除"
                                Click="OnDeleteRowClick"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 空态：表格无数据时显示，居中不遮挡表头；新增行后即时隐藏。
             IsHitTestVisible=False 让点击穿透到表格空白区，直接触发「点空白即新增」 -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.Ledgers.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
            <FontIcon
                Glyph="&#xE719;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="44"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="暂无台账记录"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="点击表格空白处即可直接录入第一条记录，也可以使用「导入单据 / OCR 识别」批量导入。"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 删除撤销 Toast：悬浮表格右下角，含「撤销」按钮；显示后 8 秒自动消失 -->
        <InfoBar
            x:Name="UndoToast"
            IsOpen="False"
            Severity="Informational"
            IsClosable="True"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,16,16"
            CornerRadius="8"
            Closed="OnUndoToastClosed">
            <InfoBar.ActionButton>
                <Button Content="撤销" Click="OnUndoClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 批量扫描识别进度卡片：识别在扫描窗口后台进行，这里悬浮展示第 N/M 张；
             识别完成后点击「打开批量核对」直接进入核对界面 -->
        <InfoBar
            x:Name="ScanProgressCard"
            IsOpen="False"
            Severity="Informational"
            IsClosable="True"
            IsIconVisible="True"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,16,64"
            CornerRadius="8"
            Message="正在解析图片...">
            <InfoBar.ActionButton>
                <Button x:Name="OpenBatchReviewButton" Content="打开批量核对" Click="OnOpenBatchReviewClick" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>

        <!-- 合计行：固定在表格最下方，金额合计按 Σ(数量×单价) 现算 -->
        <Border
            Grid.Row="4"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="合计"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="0,0,24,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="数量合计："
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.TotalQuantity, Mode=OneWay}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="金额合计："
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="元"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <ctrl:PagerBar
            Grid.Row="5"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />
    </Grid>
</Page>
