<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MaterialManagementApp.Models"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- 库存预警 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="库存预警" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="库存数量低于该阈值时，会在工作台与库存预警页中提示。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <!-- NumberBox.Value 是 double，属性是 int，x:Bind 无法隐式转换，故用经典 Binding -->
                    <NumberBox
                        Header="低库存阈值（1 - 9999）"
                        Minimum="1"
                        Maximum="9999"
                        SpinButtonPlacementMode="Compact"
                        Value="{Binding LowStockThreshold, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 单据默认值 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="单据默认值" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="新建单据时会自动带入这些值，减少重复录入。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBox Header="工程名称" Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay}" />
                    <TextBox Header="使用单位" Text="{x:Bind ViewModel.UsingUnit, Mode=TwoWay}" />
                    <TextBox Header="默认计量单位" Text="{x:Bind ViewModel.DefaultUnit, Mode=TwoWay}" />
                    <TextBox Header="默认经办人" Text="{x:Bind ViewModel.DefaultHandler, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 数据库 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="数据库" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBox
                        x:Name="DatabasePathTextBox"
                        Header="当前使用的数据库文件"
                        IsReadOnly="True"
                        TextWrapping="Wrap" />
                    <TextBox
                        Header="数据库保存位置（为空表示使用默认：程序目录\Data\MaterialSystem.db）"
                        Text="{x:Bind ViewModel.ConfiguredDatabasePath, Mode=TwoWay}"
                        PlaceholderText="例如 D:\MaterialData\MaterialSystem.db"
                        TextWrapping="Wrap" />
                    <TextBox
                        Header="默认存放目录"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.DefaultDatabaseFolder, Mode=OneWay}" />
                    <TextBox
                        Header="配置文件"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.SettingsFilePath, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="浏览…" Command="{x:Bind ViewModel.BrowseDatabasePathCommand}" />
                        <Button Content="备份数据库" Command="{x:Bind ViewModel.BackupDatabaseCommand}" />
                        <Button Content="打开所在文件夹" Command="{x:Bind ViewModel.OpenDatabaseFolderCommand}" />
                    </StackPanel>
                    <TextBlock
                        Text="修改保存位置后点击「保存」，重启程序生效；新位置首次启动会创建全新空库，迁移旧数据请先在原位置「备份数据库」。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 项目部与期数 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="项目部与期数" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="项目部（如信宜、梧州）与期数（如一期、二期）是通用业务维度：期数不与项目部绑定，任何记录可任选期数或留空，留空表示该记录没有期数（如梧州项目）。勾选适用栏目后会自动为对应数据表补上项目部/期数两列；取消勾选仅隐藏界面入口，历史数据保留。目前仅物资台账、渣土运输、自购物资完成了录入与筛选界面接入，其余栏目勾选后仅数据列就绪。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- 项目部管理：行内直接改名，点「保存」入库并级联更新业务记录 -->
                    <TextBlock Text="项目部管理" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ProjectDepts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectDept">
                                <Grid Margin="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Content="保存"
                                        Click="OnSaveDeptClick" />
                                    <Button
                                        Grid.Column="2"
                                        Content="删除"
                                        Click="OnDeleteDeptClick" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="新增项目部名称"
                            Text="{x:Bind ViewModel.NewDeptName, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Content="添加"
                            Click="OnAddDeptClick"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>

                    <!-- 期数管理：不与项目部绑定，列表结构同项目部 -->
                    <TextBlock Text="期数管理" FontWeight="SemiBold" />
                    <TextBlock
                        Text="期数由你自由维护，不与具体项目部绑定；录入时选择「无」表示该记录没有期数。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ProjectPhases, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectPhase">
                                <Grid Margin="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Content="保存"
                                        Click="OnSavePhaseClick" />
                                    <Button
                                        Grid.Column="2"
                                        Content="删除"
                                        Click="OnDeletePhaseClick" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="新增期数名称（如四期）"
                            Text="{x:Bind ViewModel.NewPhaseName, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Content="添加"
                            Click="OnAddPhaseClick"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>

                    <!-- 适用栏目：勾选即自动补列迁移，取消仅隐藏界面、保留数据 -->
                    <TextBlock Text="适用栏目" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DeptPhaseTables, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DeptPhaseApplicableTable">
                                <CheckBox
                                    Margin="0,2"
                                    Click="OnDeptPhaseTableToggleClick"
                                    Content="{x:Bind DisplayName}"
                                    IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- OCR 识别引擎配置 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="识别引擎 (OCR)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <!-- 单选框无法直接双向绑定字符串，沿用 ThemeIndex 模式：索引在 VM 内与 OcrEngineMode 双向联动 -->
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.OcrEngineIndex, Mode=TwoWay}">
                        <RadioButton AutomationProperties.Name="本地离线识别">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="本地离线识别 (Paddle/Ollama)" />
                                <TextBlock
                                    Text="免费、断网可用"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="在线 AI 识别">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="在线 AI 识别" />
                                <TextBlock
                                    Text="需联网、准确率极高、按量计费"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- AI 大模型接入配置 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="AI 大模型接入" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="配置后，导入复杂单据时将优先调用 AI 识别。API Key 仅保存在本地。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <!-- 切换服务商时 VM 会自动带入该服务商的默认 Base URL 与模型名（Ollama / 自定义除外） -->
                    <ComboBox
                        Header="AI 服务商"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.AiProviderOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.AiProvider, Mode=TwoWay}" />
                    <!-- 仅选择 Ollama 时显示本机服务配置，其余服务商 Collapsed 保持界面整洁 -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.OllamaFieldsVisibility, Mode=OneWay}">
                        <TextBox Header="Ollama 服务地址" Text="{x:Bind ViewModel.OllamaUrl, Mode=TwoWay}" />
                        <!-- IsEditable 的 ComboBox 既可下拉选择预置模型，也可直接手动输入其它模型名 -->
                        <ComboBox
                            Header="Ollama 模型名称（下拉选择或手动输入）"
                            HorizontalAlignment="Stretch"
                            IsEditable="True"
                            ItemsSource="{x:Bind ViewModel.OllamaModelOptions, Mode=OneWay}"
                            Text="{x:Bind ViewModel.OllamaModel, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBox Header="API Base URL" Text="{x:Bind ViewModel.AiBaseUrl, Mode=TwoWay}" />
                    <PasswordBox Header="API Key" Password="{x:Bind ViewModel.AiApiKey, Mode=TwoWay}" />
                    <TextBlock
                        Text="API Key 仅保存在本地配置文件中，绝不会上传到任何服务器"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBox Header="模型名称" Text="{x:Bind ViewModel.AiModelName, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="测试连接" Command="{x:Bind ViewModel.TestAiConnectionCommand}" />
                        <Button
                            Content="保存配置"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand}" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.AiStatus, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 数据库备份 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="数据库备份" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="数据库默认保存在程序所在目录的 Data 文件夹内，数据随软件走；也可在下方手动指定其他位置。旧版本安装程序指定过数据目录的，将继续沿用该目录。每次数据库版本升级前会自动备份到本机应用数据目录（%LOCALAPPDATA%\MaterialSystem\Backup）——备份放在程序目录之外，程序目录被覆盖或误删时依然完好；超出保留份数的最旧备份自动清理。卸载软件时若程序目录中仍有 Data 文件夹，卸载程序会自动把它移至 %LOCALAPPDATA%\MaterialSystem 下保存。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="手动备份" Click="OnManualBackupClick" />
                        <Button
                            Content="从备份恢复"
                            Click="OnRestoreBackupClick" />
                        <!-- NumberBox.Value 为 double、配置字段为 int，沿用页面底部的经典 Binding 约定 -->
                        <NumberBox
                            Header="备份保留份数"
                            Width="180"
                            Margin="16,0,0,0"
                            Minimum="1"
                            Maximum="99"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding BackupRetentionCount, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock
                        Text="备份保留份数修改后需点击「AI 大模型接入」卡片中的「保存配置」或页面底部「保存」按钮才会生效。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.BackupStatus, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 界面主题 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="界面主题" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <!-- ThemeIndex 与 ThemeViewModel.ThemeIndex 同为 int，x:Bind 可直接双向绑定 -->
                    <ComboBox
                        Header="界面主题"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                        <ComboBoxItem Content="透明毛玻璃" />
                        <ComboBoxItem Content="跟随系统" />
                    </ComboBox>
                    <!-- 降级提示：Win10/系统关闭透明效果时选择毛玻璃会在这里给出小字说明 -->
                    <TextBlock
                        Text="{x:Bind ViewModel.ThemeHint, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- 强调色：预设色板 + 自定义取色 -->
                    <TextBlock Text="强调色" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="选择系统强调色，影响按钮、复选框、进度条等控件，切换即时生效。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ItemsControl HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- 每个色块为可点击的圆形按钮，点击即设置强调色并即时预览 -->
                        <Button
                            x:Name="SwatchBlue"
                            Click="OnAccentSwatchClick"
                            Tag="#2563EB"
                            ToolTipService.ToolTip="经典蓝">
                            <Button.Content>
                                <Ellipse Width="28" Height="28" Fill="#2563EB" />
                            </Button.Content>
                        </Button>
                        <Button
                            x:Name="SwatchGreen"
                            Click="OnAccentSwatchClick"
                            Tag="#059669"
                            ToolTipService.ToolTip="翡翠绿">
                            <Button.Content>
                                <Ellipse Width="28" Height="28" Fill="#059669" />
                            </Button.Content>
                        </Button>
                        <Button
                            x:Name="SwatchOrange"
                            Click="OnAccentSwatchClick"
                            Tag="#D97706"
                            ToolTipService.ToolTip="琥珀橙">
                            <Button.Content>
                                <Ellipse Width="28" Height="28" Fill="#D97706" />
                            </Button.Content>
                        </Button>
                        <Button
                            x:Name="SwatchPurple"
                            Click="OnAccentSwatchClick"
                            Tag="#7C3AED"
                            ToolTipService.ToolTip="紫罗兰">
                            <Button.Content>
                                <Ellipse Width="28" Height="28" Fill="#7C3AED" />
                            </Button.Content>
                        </Button>
                        <Button
                            x:Name="SwatchPink"
                            Click="OnAccentSwatchClick"
                            Tag="#DB2777"
                            ToolTipService.ToolTip="玫红">
                            <Button.Content>
                                <Ellipse Width="28" Height="28" Fill="#DB2777" />
                            </Button.Content>
                        </Button>
                        <Button
                            x:Name="SwatchTeal"
                            Click="OnAccentSwatchClick"
                            Tag="#0891B2"
                            ToolTipService.ToolTip="青色">
                            <Button.Content>
                                <Ellipse Width="28" Height="28" Fill="#0891B2" />
                            </Button.Content>
                        </Button>
                        <Button
                            x:Name="SwatchSlate"
                            Click="OnAccentSwatchClick"
                            Tag="#475569"
                            ToolTipService.ToolTip="石墨">
                            <Button.Content>
                                <Ellipse Width="28" Height="28" Fill="#475569" />
                            </Button.Content>
                        </Button>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ColorPicker
                            x:Name="AccentColorPicker"
                            ColorChanged="OnAccentColorPickerColorChanged"
                            IsColorPreviewVisible="True"
                            IsColorChannelTextInputVisible="False"
                            IsHexInputVisible="True"
                            IsMoreButtonVisible="False"
                            MinWidth="280" />
                        <TextBlock
                            Text="{x:Bind ViewModel.AccentColor, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关闭行为 -->
            <Border
                Style="{StaticResource StatCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="关闭窗口行为" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        Header="点击右上角 X 时"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.CloseActionOptions, Mode=OneTime}"
                        SelectedIndex="{x:Bind ViewModel.CloseActionIndex, Mode=TwoWay}" />
                    <TextBlock
                        Text="每次询问：关闭时弹窗让你选择直接退出或最小化到托盘，可勾选「记住我的选择」不再提示；最小化到托盘：窗口隐藏并驻留系统托盘，OCR 监听、台账轮询等任务继续在后台运行，左键点击托盘图标唤起主窗口，右键菜单提供「显示主窗口」与「退出软件」；直接退出：关闭窗口并结束程序，相关进程全部退出。修改后点击「保存」生效。"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Content="保存"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="恢复默认" Command="{x:Bind ViewModel.ResetToDefaultCommand}" />
            </StackPanel>

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
