<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.SupplierContractPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaterialManagementApp.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 新增行的「取消」与已有行的「删除」按 IsNewRow 互斥显示 -->
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- 供应商合同页面：上方维护供应商合同信息，下方管理该供应商的合同 PDF 文件 -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="供应商合同" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 查询筛选面板 -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="供应商名称"
                    MinWidth="180"
                    Text="{x:Bind ViewModel.NameKeyword, Mode=TwoWay}" />
                <TextBox
                    Grid.Column="1"
                    Header="合同编号"
                    MinWidth="160"
                    Text="{x:Bind ViewModel.ContractNoKeyword, Mode=TwoWay}" />
                <Button
                    Grid.Column="2"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="3"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
            </Grid>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新增" Click="OnNewRowClick" />
                <Button Content="删除" Click="OnDeleteSelectedClick" />
                <Button Content="导出" Click="OnExportClick" />
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 供应商合同表格 -->
        <controls:DataGrid
            x:Name="LedgerGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="False"
            SelectionMode="Single"
            SelectionChanged="OnLedgerSelectionChanged"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn
                    Binding="{Binding Name, Mode=TwoWay}"
                    Header="供应商名称" />
                <controls:DataGridTextColumn
                    Binding="{Binding ContractNo, Mode=TwoWay}"
                    Header="合同编号" />
                <controls:DataGridTextColumn
                    Binding="{Binding ContactPerson, Mode=TwoWay}"
                    Header="联系人" />
                <controls:DataGridTextColumn
                    Binding="{Binding SignDate, Mode=TwoWay}"
                    Header="签订日期" />
                <controls:DataGridTextColumn
                    Binding="{Binding ContractFilePath, Mode=OneWay}"
                    Header="合同文件" />
                <controls:DataGridTemplateColumn Header="操作">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="保存" Click="OnSaveRowClick" />
                                <Button
                                    Content="删除"
                                    Click="OnDeleteRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button
                                    Content="取消"
                                    Click="OnCancelNewRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 合计行 -->
        <Border
            Grid.Row="4"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Border>

        <ctrl:PagerBar
            Grid.Row="5"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />

        <!-- 合同文件管理区：选中供应商后上传/打开/清除合同 PDF -->
        <Border
            Grid.Row="6"
            Margin="0,12,0,0"
            Padding="20"
            CornerRadius="8">
            <StackPanel Spacing="12">
                <TextBlock Text="合同文件" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <TextBlock
                    x:Name="ContractFileNameText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="未选择供应商"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="上传合同 PDF" Click="OnUploadContractClick" />
                    <Button x:Name="OpenContractBtn" Content="打开合同" Click="OnOpenContractClick" />
                    <Button x:Name="ClearContractBtn" Content="清除合同文件" Click="OnClearContractClick" />
                </StackPanel>

                <TextBlock
                    x:Name="ContractFileStatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
