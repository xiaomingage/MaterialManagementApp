<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.WriteOffMonthlyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 上下分栏：第 1~2 行为查询与操作区（紧凑），第 3 行为数据列表（占满剩余高度） -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="月度核销" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 上半部分：查询筛选面板。月份留空表示全部月份 -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="核销月份（yyyy-MM，留空为全部）"
                    MinWidth="240"
                    Text="{x:Bind ViewModel.MonthFilter, Mode=TwoWay}" />
                <Button
                    Grid.Column="1"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="2"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
            </Grid>
        </Border>

        <!-- 下半部分：只读汇总，工具栏只保留导出/刷新 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="导出" Click="OnExportClick" />
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 表格区：只读月度汇总 -->
        <ctrl:LedgerDataGrid
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.Summaries, Mode=OneWay}">
            <ctrl:LedgerDataGrid.Columns>
                <controls:DataGridTextColumn Binding="{Binding WriteOffMonth}" Header="核销月份" />
                <controls:DataGridTextColumn Binding="{Binding ItemCount}" Header="记录条数" />
                <controls:DataGridTextColumn Binding="{Binding TotalQty}" Header="数量合计" />
                <controls:DataGridTextColumn Binding="{Binding TotalAmount}" Header="金额合计（元）" />
            </ctrl:LedgerDataGrid.Columns>
        </ctrl:LedgerDataGrid>

        <!-- 合计行：固定在表格最下方 -->
        <Border
            Grid.Row="4"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Border>

        <ctrl:PagerBar
            Grid.Row="5"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />
    </Grid>
</Page>
