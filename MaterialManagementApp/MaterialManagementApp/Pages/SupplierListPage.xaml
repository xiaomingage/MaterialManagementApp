<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.SupplierListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaterialManagementApp.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 新增行的「取消」与已有行的「删除」按 IsNewRow 互斥显示 -->
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- 上下分栏：查询与操作区、数据列表、合计、分页、合同材料单价明细 -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="供应商列表" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 上半部分：查询筛选面板。点击「查询」按条件重新加载，点击「重置」清空条件 -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="供应商名称"
                    MinWidth="180"
                    Text="{x:Bind ViewModel.NameKeyword, Mode=TwoWay}" />
                <TextBox
                    Grid.Column="1"
                    Header="合同编号"
                    MinWidth="160"
                    Text="{x:Bind ViewModel.ContractNoKeyword, Mode=TwoWay}" />
                <Button
                    Grid.Column="2"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="3"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
            </Grid>
        </Border>

        <!-- 下半部分：表格上方的操作按钮。「新增」直接在表格首行插入空白行，不再弹出录入表单 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新增" Click="OnNewRowClick" />
                <Button Content="删除" Click="OnDeleteSelectedClick" />
                <Button Content="导出" Click="OnExportClick" />
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 表格区：单元格可编辑；行末按行状态显示保存/删除或保存/取消 -->
        <controls:DataGrid
            x:Name="LedgerGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="False"
            SelectionMode="Single"
            SelectionChanged="OnLedgerSelectionChanged"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn
                    Binding="{Binding Name, Mode=TwoWay}"
                    Header="供应商名称" />
                <controls:DataGridTextColumn
                    Binding="{Binding ContractNo, Mode=TwoWay}"
                    Header="合同编号" />
                <controls:DataGridTextColumn
                    Binding="{Binding ContactPerson, Mode=TwoWay}"
                    Header="联系人" />
                <controls:DataGridTextColumn
                    Binding="{Binding Phone, Mode=TwoWay}"
                    Header="联系电话" />
                <controls:DataGridTextColumn
                    Binding="{Binding MonthlySettlement, Mode=TwoWay}"
                    Header="月度结算" />
                <controls:DataGridTextColumn
                    Binding="{Binding SignDate, Mode=TwoWay}"
                    Header="签约日期" />
                <controls:DataGridTextColumn
                    Binding="{Binding Remark, Mode=TwoWay}"
                    Header="备注" />
                <!-- 行内操作列：模板列内按钮的 DataContext 就是该行数据，因此用 Click 事件处理 -->
                <controls:DataGridTemplateColumn Header="操作">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- 保存：空白新增行执行入库，已有行执行更新 -->
                                <Button Content="保存" Click="OnSaveRowClick" />
                                <!-- 删除：仅已入库的行显示 -->
                                <Button
                                    Content="删除"
                                    Click="OnDeleteRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <!-- 取消：仅尚未入库的新增行显示，点击后直接移除该行 -->
                                <Button
                                    Content="取消"
                                    Click="OnCancelNewRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 合计行：固定在表格最下方 -->
        <Border
            Grid.Row="4"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Border>

        <ctrl:PagerBar
            Grid.Row="5"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />

        <!-- 合同材料单价明细区：选中上方供应商后显示其各材料单价，供地材台账 OCR 导入时自动匹配 -->
        <Border
            Grid.Row="6"
            Margin="0,12,0,0"
            Padding="16"
            CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="合同材料单价明细（选中上方供应商后显示）"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Content="新增" Click="OnItemNewRowClick" />
                    <Button Content="删除" Click="OnItemDeleteSelectedClick" />
                    <Button Content="刷新" Click="OnItemRefreshClick" />
                    <TextBlock
                        x:Name="ItemStatusText"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <controls:DataGrid
                    x:Name="ItemGrid"
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="All"
                    IsReadOnly="False"
                    SelectionMode="Single"
                    SelectionChanged="OnItemSelectionChanged"
                    ItemsSource="{x:Bind ContractItems.Items, Mode=OneWay}">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn
                            Binding="{Binding MaterialName, Mode=TwoWay}"
                            Header="材料名称" />
                        <controls:DataGridTextColumn
                            Binding="{Binding Specification, Mode=TwoWay}"
                            Header="规格" />
                        <controls:DataGridTextColumn
                            Binding="{Binding Unit, Mode=TwoWay}"
                            Header="单位" />
                        <controls:DataGridTextColumn
                            Binding="{Binding UnitPrice, Mode=TwoWay}"
                            Header="单价（元）" />
                        <controls:DataGridTextColumn
                            Width="*"
                            Binding="{Binding Remark, Mode=TwoWay}"
                            Header="备注" />
                        <controls:DataGridTemplateColumn Header="操作">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="保存" Click="OnItemSaveRowClick" />
                                        <Button
                                            Content="删除"
                                            Click="OnItemDeleteRowClick"
                                            Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Button
                                            Content="取消"
                                            Click="OnItemCancelNewRowClick"
                                            Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
