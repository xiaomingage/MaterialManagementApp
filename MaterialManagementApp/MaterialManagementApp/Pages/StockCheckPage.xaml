<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.StockCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 上下分栏：第 1~2 行为查询与操作区（紧凑），第 3 行为数据列表（占满剩余高度） -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="库存查询" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 上半部分：查询筛选面板。点击「查询」按条件重新加载，点击「重置」清空条件 -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SelectedItem 为 object，用经典 Binding 完成 object 到 string 的转换 -->
                <ComboBox
                    Grid.Column="0"
                    Header="物资来源"
                    MinWidth="110"
                    ItemsSource="{x:Bind ViewModel.SourceOptions, Mode=OneWay}"
                    SelectedItem="{Binding SelectedSource, Mode=TwoWay}" />
                <TextBox
                    Grid.Column="1"
                    Header="物资名称"
                    MinWidth="160"
                    Text="{Binding NameKeyword, Mode=TwoWay}" />
                <Button
                    Grid.Column="2"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="3"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
            </Grid>
        </Border>

        <!-- 下半部分：表格上方的操作按钮。本页为聚合只读数据，无新增/删除 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="导出" Click="OnExportClick" />
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 表格区：聚合汇总数据，整表只读 -->
        <controls:DataGrid
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="True"
            SelectionMode="Single"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Binding="{Binding MaterialName}" Header="物资名称" />
                <controls:DataGridTextColumn Binding="{Binding Specification}" Header="规格型号" />
                <controls:DataGridTextColumn Binding="{Binding Unit}" Header="单位" />
                <controls:DataGridTextColumn Binding="{Binding InQty}" Header="累计入库" />
                <controls:DataGridTextColumn Binding="{Binding OutQty}" Header="累计出库" />
                <controls:DataGridTextColumn Binding="{Binding ReturnQty}" Header="累计退库" />
                <controls:DataGridTextColumn Binding="{Binding Balance}" Header="账面结存" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 合计行：固定在表格最下方 -->
        <Border
            Grid.Row="4"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Border>

        <ctrl:PagerBar
            Grid.Row="5"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />
    </Grid>
</Page>
