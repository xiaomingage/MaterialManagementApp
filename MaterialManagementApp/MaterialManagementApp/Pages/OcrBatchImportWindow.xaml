<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MaterialManagementApp.Pages.OcrBatchImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="批量扫描识别"
    xmlns:common="using:MaterialManagementApp.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 根容器同时是拖拽投放区：整个窗口都接受拖入图片。
         Window 不是 FrameworkElement 没有 Resources，转换器资源挂在根 Grid 上 -->
    <Grid
        Padding="16"
        RowSpacing="12"
        AllowDrop="True"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop">
        <Grid.Resources>
            <common:StringToVisibilityConverter x:Key="StringToVisibility" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题与取图工具栏 -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="批量扫描识别" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Content="选择图片（可多选）"
                    Click="OnPickImagesClick"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="粘贴图片" Click="OnPasteClick" />
                <Button Content="截屏" Click="OnCaptureClick" />
                <TextBlock
                    Text="也可把多张图片直接拖进本窗口。每张单据一个卡片：识别有误可直接改文字或字段，改好一张点该卡片的「保存入台账」。"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="560"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 全局状态提示条：有消息才显示 -->
        <Border
            Grid.Row="1"
            Padding="12,7"
            CornerRadius="4"
            HorizontalAlignment="Left"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            Visibility="{Binding Text, ElementName=GlobalStatus, Converter={StaticResource StringToVisibility}}">
            <TextBlock
                x:Name="GlobalStatus"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </Border>

        <!-- 卡片列表：一张图片一张卡片，纵向滚动 -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="CardList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,12,12"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>

                                <!-- 缩略图与文件信息 -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <Border
                                        Height="150"
                                        CornerRadius="4"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        Text="{Binding FileName}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding SourcePath}" />
                                    <Button
                                        Content="移除"
                                        Click="OnRemoveItemClick"
                                        HorizontalAlignment="Left"
                                        Padding="12,4" />
                                </StackPanel>

                                <!-- 识别全文：可手动修正，改完可重提字段 -->
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock
                                        Text="识别文字（可手动修正）"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox
                                        Text="{Binding RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="170"
                                        FontSize="13"
                                        IsReadOnly="{Binding IsSaved}"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        PlaceholderText="识别全文会显示在这里" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Content="按当前文字重提字段"
                                            Click="OnReExtractClick"
                                            IsEnabled="{Binding IsEditable}"
                                            Padding="12,4" />
                                        <ProgressRing
                                            Width="24"
                                            Height="24"
                                            IsActive="{Binding IsBusy}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 字段区：识别结果预填，识别不到的直接手动填。
                                     Grid 不是 Control 没有 IsEnabled，用 ContentControl 承载 -->
                                <ContentControl
                                    Grid.Column="2"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    IsEnabled="{Binding IsEditable}">
                                    <Grid ColumnSpacing="8" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox
                                        Grid.Row="0" Grid.Column="0"
                                        Header="物资名称 *"
                                        Text="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="0" Grid.Column="1"
                                        Header="规格"
                                        Text="{Binding Specification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="1" Grid.Column="0"
                                        Header="数量"
                                        Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="1" Grid.Column="1"
                                        Header="单位"
                                        Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="2" Grid.Column="0"
                                        Header="单价（识别不出可留空走合同匹配）"
                                        Text="{Binding UnitPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="2" Grid.Column="1"
                                        Header="进场日期"
                                        Text="{Binding EntryDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="3" Grid.Column="0"
                                        Header="单据编号"
                                        Text="{Binding DocNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="3" Grid.Column="1"
                                        Header="供应商"
                                        Text="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="4" Grid.Column="0"
                                        Header="经办人"
                                        Text="{Binding Handler, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Row="4" Grid.Column="1"
                                        Header="车牌号"
                                        Text="{Binding PlateNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </ContentControl>

                                <!-- 独立保存：每张单据一个按钮，互不影响 -->
                                <StackPanel Grid.Column="3" Spacing="8">
                                    <Button
                                        Content="保存入台账"
                                        Click="OnSaveItemClick"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding IsEditable}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                    <TextBlock
                                        Text="{Binding StatusText}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
