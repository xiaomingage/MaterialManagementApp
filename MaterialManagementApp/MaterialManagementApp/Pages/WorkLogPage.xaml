<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.WorkLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaterialManagementApp.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 新增行的「取消」与已有行的「删除」按 IsNewRow 互斥显示 -->
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- 上下分栏：第 1 行为今日日志快速录入区，第 2~4 行为查询、操作区与数据列表 -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="工作日志" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 今日日志快速录入：日期与星期由系统时间自动填充、天气下拉一键切换、
             工作内容为多行文本框，填好后点「导出Word」按模板生成 工作日志-yyyy-MM-dd.docx -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.TodayDisplayText, Mode=OneWay}" />
                <!-- SelectedItem 为 object，用经典 Binding 完成 object 到 string 的转换 -->
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Header="天气"
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.WeatherOptions, Mode=OneWay}"
                    SelectedItem="{Binding SelectedWeather, Mode=TwoWay}" />
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    Content="导出Word"
                    VerticalAlignment="Bottom"
                    Click="OnExportWordClick"
                    Style="{ThemeResource AccentButtonStyle}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Header="今日工作内容"
                    Height="120"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    PlaceholderText="请输入今天的工作事项……"
                    Text="{Binding WorkContent, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- 上半部分：查询筛选面板。点击「查询」按条件重新加载，点击「重置」清空条件 -->
        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- DatePicker.Date 是 DateTimeOffset，而筛选属性是可空 DateTimeOffset?，
                     x:Bind 不接受这种可空收窄，因此这里用经典 Binding 由运行时转换 -->
                <DatePicker
                    Grid.Column="0"
                    Header="开始日期"
                    Date="{Binding StartDate, Mode=TwoWay}" />
                <DatePicker
                    Grid.Column="1"
                    Header="结束日期"
                    Date="{Binding EndDate, Mode=TwoWay}" />
                <TextBox
                    Grid.Column="2"
                    Header="内容关键字"
                    MinWidth="160"
                    Text="{Binding ContentKeyword, Mode=TwoWay}" />
                <Button
                    Grid.Column="3"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="4"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
            </Grid>
        </Border>

        <!-- 下半部分：表格上方的操作按钮。「新增」直接在表格首行插入空白行，不再弹出录入表单 -->
        <StackPanel Grid.Row="3" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新增" Click="OnNewRowClick" />
                <Button Content="删除" Click="OnDeleteSelectedClick" />
                <Button Content="导出" Click="OnExportClick" />
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 表格区：单元格可编辑；行末按行状态显示保存/删除或保存/取消 -->
        <controls:DataGrid
            x:Name="LedgerGrid"
            Grid.Row="4"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="False"
            SelectionMode="Single"
            SelectionChanged="OnLedgerSelectionChanged"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn
                    Binding="{Binding LogDate, Mode=TwoWay}"
                    Header="记录日期" />
                <controls:DataGridTextColumn
                    Binding="{Binding Content, Mode=TwoWay}"
                    Header="日志内容" />
                <controls:DataGridTextColumn
                    Binding="{Binding CreatedAt, Mode=OneWay}"
                    Header="创建时间"
                    IsReadOnly="True" />
                <!-- 行内操作列：模板列内按钮的 DataContext 就是该行数据，因此用 Click 事件处理 -->
                <controls:DataGridTemplateColumn Header="操作">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- 保存：空白新增行执行入库，已有行执行更新 -->
                                <Button Content="保存" Click="OnSaveRowClick" />
                                <!-- 删除：仅已入库的行显示 -->
                                <Button
                                    Content="删除"
                                    Click="OnDeleteRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <!-- 取消：仅尚未入库的新增行显示，点击后直接移除该行 -->
                                <Button
                                    Content="取消"
                                    Click="OnCancelNewRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 合计行：固定在表格最下方 -->
        <Border
            Grid.Row="5"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Border>

        <ctrl:PagerBar
            Grid.Row="6"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />
    </Grid>
</Page>
