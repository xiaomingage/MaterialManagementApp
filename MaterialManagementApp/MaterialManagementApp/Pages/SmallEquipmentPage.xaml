<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaterialManagementApp.Pages.SmallEquipmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaterialManagementApp.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctrl="using:MaterialManagementApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 新增行的「取消」与已有行的「删除」按 IsNewRow 互斥显示 -->
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- 上下分栏：第 1~2 行为查询与操作区（紧凑），第 3 行为数据列表（占满剩余高度） -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="小型机具台账" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- 上半部分：查询筛选面板。点击「查询」按条件重新加载，点击「重置」清空条件 -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="机具名称"
                    MinWidth="150"
                    Text="{Binding NameKeyword, Mode=TwoWay}" />
                <TextBox
                    Grid.Column="1"
                    Header="编号"
                    MinWidth="130"
                    Text="{Binding CodeKeyword, Mode=TwoWay}" />
                <!-- SelectedItem 为 object，用经典 Binding 完成 object 到 string 的转换 -->
                <ComboBox
                    Grid.Column="2"
                    Header="性能状态"
                    MinWidth="100"
                    ItemsSource="{x:Bind ViewModel.PerformanceStatusOptions, Mode=OneWay}"
                    SelectedItem="{Binding SelectedPerformanceStatus, Mode=TwoWay}" />
                <Button
                    Grid.Column="3"
                    Content="查询"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.QueryCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Grid.Column="4"
                    Content="重置"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ResetFilterCommand}" />
            </Grid>
        </Border>

        <!-- 下半部分：表格上方的操作按钮。「新增」直接在表格首行插入空白行，不再弹出录入表单 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新增" Click="OnNewRowClick" />
                <Button Content="删除" Click="OnDeleteSelectedClick" />
                <Button Content="导出" Click="OnExportTemplateClick" />
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadCommand}" />
                <Button Content="从模板导入" Click="OnImportTemplateClick" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 表格区：单元格可编辑；行末按行状态显示保存/删除或保存/取消 -->
        <controls:DataGrid
            x:Name="LedgerGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="False"
            SelectionMode="Single"
            SelectionChanged="OnLedgerSelectionChanged"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn
                    Binding="{Binding Code, Mode=TwoWay}"
                    Header="编号" />
                <controls:DataGridTextColumn
                    Binding="{Binding Name, Mode=TwoWay}"
                    Header="机具名称" />
                <controls:DataGridTextColumn
                    Binding="{Binding Specification, Mode=TwoWay}"
                    Header="规格型号" />
                <controls:DataGridTextColumn
                    Binding="{Binding Category, Mode=TwoWay}"
                    Header="类别" />
                <controls:DataGridTextColumn
                    Binding="{Binding Unit, Mode=TwoWay}"
                    Header="计量单位" />
                <controls:DataGridTextColumn
                    Binding="{Binding Quantity, Mode=TwoWay}"
                    Header="数量" />
                <controls:DataGridTextColumn
                    Binding="{Binding PerformanceStatus, Mode=TwoWay}"
                    Header="性能状态" />
                <controls:DataGridTextColumn
                    Binding="{Binding ProjectShortName, Mode=TwoWay}"
                    Header="项目简称" />
                <controls:DataGridTextColumn
                    Binding="{Binding WorkSite, Mode=TwoWay}"
                    Header="使用项目工点" />
                <controls:DataGridTextColumn
                    Binding="{Binding ConfigMethod, Mode=TwoWay}"
                    Header="配置方式" />
                <controls:DataGridTextColumn
                    Binding="{Binding AssetOwner, Mode=TwoWay}"
                    Header="资产所属单位" />
                <controls:DataGridTextColumn
                    Binding="{Binding Manufacturer, Mode=TwoWay}"
                    Header="生产厂家" />
                <controls:DataGridTextColumn
                    Binding="{Binding FactoryDate, Mode=TwoWay}"
                    Header="出厂时间" />
                <controls:DataGridTextColumn
                    Binding="{Binding ImagePath, Mode=TwoWay}"
                    Header="照片路径" />
                <!-- 行内按钮的 DataContext 是该行数据对象，无法绑定 ViewModel 命令，必须用 Click 事件 -->
                <controls:DataGridTemplateColumn Header="照片">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="查看" Click="OnOpenPhotoClick" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <!-- 行内操作列：模板列内按钮的 DataContext 就是该行数据，因此用 Click 事件处理 -->
                <controls:DataGridTemplateColumn Header="操作">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- 保存：空白新增行执行入库，已有行执行更新 -->
                                <Button Content="保存" Click="OnSaveRowClick" />
                                <!-- 删除：仅已入库的行显示 -->
                                <Button
                                    Content="删除"
                                    Click="OnDeleteRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <!-- 取消：仅尚未入库的新增行显示，点击后直接移除该行 -->
                                <Button
                                    Content="取消"
                                    Click="OnCancelNewRowClick"
                                    Visibility="{Binding IsNewRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 合计行：固定在表格最下方 -->
        <Border
            Grid.Row="4"
            Padding="12,8"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Border>

        <ctrl:PagerBar
            Grid.Row="5"
            CurrentPage="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
            TotalCount="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
            TotalPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
            PreviousCommand="{x:Bind ViewModel.PreviousPageCommand}"
            NextCommand="{x:Bind ViewModel.NextPageCommand}"
            PageSizeCommand="{x:Bind ViewModel.ChangePageSizeCommand}" />
    </Grid>
</Page>
