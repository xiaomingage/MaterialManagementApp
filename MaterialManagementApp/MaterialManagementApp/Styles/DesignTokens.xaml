<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- 设计 Token（微信 PC 风格改版）：圆角、间距、动画时长。          -->
    <!-- 配色基调：浅色=素雅浅灰白（灰底白卡分层）、深色=柔和深灰（卡片   -->
    <!-- 比背景浅一级）、毛玻璃=桌面亚克力 + 半透明磨砂卡片；卡片无边框    -->
    <!-- 无重阴影，层次靠底色深浅；导航选中=侧边竖线+文字变色；焦点用     -->
    <!-- 强调色细线；全局无动画无渐变。                                  -->
    <!-- ============================================================ -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Default 兜底（高对比度等场景）：与 Light 一致，保证任何主题下均有可读取值 -->
            <!-- 窗口底色：素雅浅灰白（覆盖系统键，全局页面背景同步生效） -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F4F5F6" />
            <!-- 导航栏：比内容底深一档的浅灰，贴近微信侧栏 -->
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F4F5F6" />
            <SolidColorBrush x:Key="NavigationViewCollapsedPaneBackground" Color="#F4F5F6" />
            <!-- 内容区边框彻底不渲染：NavigationView 模板的 ContentGrid 默认带 1,1,0,0 边框
                 （窗格右侧竖线 + 标题栏下横线），厚度归零 + 画刷透明，线条不再绘制 -->
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <!-- 微信式选中态：无大块底色，靠侧边竖线 + 文字变色（两键在下方） -->
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <!-- 卡片描边：完全去掉边框，层次靠底色深浅 -->
            <SolidColorBrush x:Key="AppCardStrokeBrush" Color="Transparent" />
            <!-- 卡片/白卡磁贴悬停态：比表面深一档的极浅灰（微信式 hover 反馈） -->
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E5E6E8" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E5E6E8" />
            <!-- DataGrid 极浅灰细网格线 -->
            <SolidColorBrush x:Key="AppDataGridGridLineBrush" Color="#E8E9EB" />
            <!-- DataGrid 表头：浅灰底，hover/按下轻微加深 -->
            <Color x:Key="AppHeaderBackgroundColor">#EDEEF0</Color>
            <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="{StaticResource AppHeaderBackgroundColor}" />
            <Color x:Key="AppHeaderHoveredBackgroundColor">#E6E7EA</Color>
            <Color x:Key="AppHeaderPressedBackgroundColor">#DFE0E3</Color>
            <SolidColorBrush x:Key="AppHeaderHoveredBackgroundBrush" Color="{StaticResource AppHeaderHoveredBackgroundColor}" />
            <SolidColorBrush x:Key="AppHeaderPressedBackgroundBrush" Color="{StaticResource AppHeaderPressedBackgroundColor}" />
            <!-- 输入框柔和细描边，聚焦改用强调色细线提示 -->
            <SolidColorBrush x:Key="AppInputBorderBrush" Color="#D9DADC" />
            <SolidColorBrush x:Key="AppInputBorderHoverBrush" Color="#C7C8CB" />
            <SolidColorBrush x:Key="AppInputBorderFocusBrush" Color="#2563EB" />
            <StaticResource x:Key="TextControlBorderThemeBrush" ResourceKey="AppInputBorderBrush" />
            <StaticResource x:Key="TextControlBorderThemeBrushPointerOver" ResourceKey="AppInputBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderThemeBrushFocused" ResourceKey="AppInputBorderFocusBrush" />
            <!-- WinUI 3 TextBox 实际引用的是不带 Theme 后缀的键（上方 ThemeBrush 系为旧版键名），
                 同步映射到柔和描边，聚焦仍用强调色细线 -->
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="AppInputBorderBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AppInputBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AppInputBorderFocusBrush" />
            <!-- 去除聚焦黑白双层焦点圈：DataGrid 编辑框在彩色选中行上会显示为粗黑圆角框 -->
            <SolidColorBrush x:Key="TextControlFocusVisualBlackBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlFocusVisualWhiteBrush" Color="Transparent" />
            <!-- DataGrid 单元格：清除默认黑色焦点外圈 -->
            <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
            <!-- 当前单元格：柔和强调色细描边 -->
            <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="#2563EB" Opacity="0.55" />
            <!-- 微信式侧栏选中：侧边短竖线 + 文字变强调色 -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2563EB" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#2563EB" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- 浅色主题：素雅浅灰白底，白卡片靠底色深浅分层，无硬边框 -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F4F5F6" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F4F5F6" />
            <SolidColorBrush x:Key="NavigationViewCollapsedPaneBackground" Color="#F4F5F6" />
            <!-- 内容区边框彻底不渲染：与 Default 兜底一致 -->
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="AppCardStrokeBrush" Color="Transparent" />
            <!-- 卡片/白卡磁贴悬停态：比表面深一档的极浅灰（微信式 hover 反馈） -->
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E5E6E8" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E5E6E8" />
            <!-- DataGrid 极浅灰细网格线 -->
            <SolidColorBrush x:Key="AppDataGridGridLineBrush" Color="#E8E9EB" />
            <!-- DataGrid 表头：浅灰底，hover/按下轻微加深 -->
            <Color x:Key="AppHeaderBackgroundColor">#EDEEF0</Color>
            <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="{StaticResource AppHeaderBackgroundColor}" />
            <Color x:Key="AppHeaderHoveredBackgroundColor">#E6E7EA</Color>
            <Color x:Key="AppHeaderPressedBackgroundColor">#DFE0E3</Color>
            <SolidColorBrush x:Key="AppHeaderHoveredBackgroundBrush" Color="{StaticResource AppHeaderHoveredBackgroundColor}" />
            <SolidColorBrush x:Key="AppHeaderPressedBackgroundBrush" Color="{StaticResource AppHeaderPressedBackgroundColor}" />
            <!-- 输入框柔和细描边，聚焦改用强调色细线提示 -->
            <SolidColorBrush x:Key="AppInputBorderBrush" Color="#D9DADC" />
            <SolidColorBrush x:Key="AppInputBorderHoverBrush" Color="#C7C8CB" />
            <SolidColorBrush x:Key="AppInputBorderFocusBrush" Color="#2563EB" />
            <StaticResource x:Key="TextControlBorderThemeBrush" ResourceKey="AppInputBorderBrush" />
            <StaticResource x:Key="TextControlBorderThemeBrushPointerOver" ResourceKey="AppInputBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderThemeBrushFocused" ResourceKey="AppInputBorderFocusBrush" />
            <!-- WinUI 3 TextBox 实际引用的是不带 Theme 后缀的键（上方 ThemeBrush 系为旧版键名），
                 同步映射到柔和描边，聚焦仍用强调色细线 -->
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="AppInputBorderBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AppInputBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AppInputBorderFocusBrush" />
            <!-- 去除聚焦黑白双层焦点圈：DataGrid 编辑框在彩色选中行上会显示为粗黑圆角框 -->
            <SolidColorBrush x:Key="TextControlFocusVisualBlackBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlFocusVisualWhiteBrush" Color="Transparent" />
            <!-- DataGrid 单元格：清除默认黑色焦点外圈 -->
            <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
            <!-- 当前单元格：柔和强调色细描边 -->
            <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="#2563EB" Opacity="0.55" />
            <!-- 微信式侧栏选中：侧边短竖线 + 文字变强调色 -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2563EB" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#2563EB" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- 深色主题：柔和深灰底，卡片比背景浅一级，分割线极低对比，无白色边线 -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1D1D20" />
            <!-- 侧栏与页面底同色：深色分层仅靠底色深浅，窗格边界不画任何线条 -->
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#1D1D20" />
            <SolidColorBrush x:Key="NavigationViewCollapsedPaneBackground" Color="#1D1D20" />
            <!-- 内容区边框彻底不渲染：WinUI NavigationView 模板 ContentGrid 默认 1,1,0,0
                 边框（取 CardStrokeColorDefaultBrush #222226，比底色亮一档）就是左侧竖线的来源，
                 厚度归零后不再渲染，而非用深色遮盖 -->
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="AppCardStrokeBrush" Color="Transparent" />
            <!-- 卡片/白卡磁贴悬停态：比表面深一档的极浅灰（微信式 hover 反馈） -->
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#2A2A2F" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#222226" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#26262A" />
            <!-- DataGrid 深灰细网格线（极低对比） -->
            <SolidColorBrush x:Key="AppDataGridGridLineBrush" Color="#2B2B30" />
            <Color x:Key="AppHeaderBackgroundColor">#252529</Color>
            <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="{StaticResource AppHeaderBackgroundColor}" />
            <Color x:Key="AppHeaderHoveredBackgroundColor">#2C2C31</Color>
            <Color x:Key="AppHeaderPressedBackgroundColor">#333338</Color>
            <SolidColorBrush x:Key="AppHeaderHoveredBackgroundBrush" Color="{StaticResource AppHeaderHoveredBackgroundColor}" />
            <SolidColorBrush x:Key="AppHeaderPressedBackgroundBrush" Color="{StaticResource AppHeaderPressedBackgroundColor}" />
            <!-- 输入框低对比描边，聚焦用亮一档的强调色细线 -->
            <SolidColorBrush x:Key="AppInputBorderBrush" Color="#3A3A40" />
            <SolidColorBrush x:Key="AppInputBorderHoverBrush" Color="#48484F" />
            <SolidColorBrush x:Key="AppInputBorderFocusBrush" Color="#7FA6F2" />
            <StaticResource x:Key="TextControlBorderThemeBrush" ResourceKey="AppInputBorderBrush" />
            <StaticResource x:Key="TextControlBorderThemeBrushPointerOver" ResourceKey="AppInputBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderThemeBrushFocused" ResourceKey="AppInputBorderFocusBrush" />
            <!-- WinUI 3 TextBox 实际引用的是不带 Theme 后缀的键（上方 ThemeBrush 系为旧版键名），
                 同步映射到柔和描边，聚焦仍用强调色细线 -->
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="AppInputBorderBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AppInputBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AppInputBorderFocusBrush" />
            <!-- 去除聚焦黑白双层焦点圈：DataGrid 编辑框在彩色选中行上会显示为粗黑圆角框 -->
            <SolidColorBrush x:Key="TextControlFocusVisualBlackBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlFocusVisualWhiteBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="#7FA6F2" Opacity="0.7" />
            <!-- 微信式侧栏选中：侧边短竖线 + 文字变亮一档强调色 -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#7FA6F2" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#7FA6F2" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 卡片/状态栏表面笔刷：统计卡、弹窗等局部面板统一从这里取底色。
         默认为白色纯色兜底；运行期由 ThemeHelper.ApplyMode 按主题模式覆盖——
         透明毛玻璃（或跟随系统且系统开启透明）时为对应深浅基底的亚克力磨砂笔刷；
         浅色/深色时为不透明纯色。豆包式分层：只用背景色深浅区分，卡片不绘制任何边框线 -->
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />

    <!-- 内容区底色：纯色主题与页面背景一致；毛玻璃模式运行期覆盖为透明，
         让整个窗口透出桌面亚克力。根级兜底为浅灰白 -->
    <SolidColorBrush x:Key="AppContentBackgroundBrush" Color="#F4F5F6" />

    <!-- 弹窗表面笔刷：与卡片分离，不透明干净背景，圆角柔和 -->
    <SolidColorBrush x:Key="AppDialogBrush" Color="#F7F8F9" />

    <!-- 圆角：微信式偏小——控件 4px，卡片 4px，对话框 8px -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- 间距 Token -->
    <x:Double x:Key="SpacingPage">24</x:Double>
    <x:Double x:Key="SpacingSection">20</x:Double>
    <x:Double x:Key="SpacingCard">12</x:Double>
    <x:Double x:Key="SpacingControl">8</x:Double>

    <!-- 动画时长 Token 保留供引用，但按「全局无动画」要求不再新增过渡效果 -->
    <x:Double x:Key="DurationFast">120</x:Double>
    <x:Double x:Key="DurationNormal">200</x:Double>
    <x:Double x:Key="DurationSlow">300</x:Double>

    <!-- 卡片阴影：ThemeShadow 由 WinUI 3 自动根据 z 轴偏移投射柔和阴影 -->
    <ThemeShadow x:Key="CardShadow" />

    <!-- 强调色（覆盖系统默认，统一品牌感；调色功能保留） -->
    <Color x:Key="AppAccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />

    <!-- WinUI 3 不内置 SystemAccentColor*Brush 系列（UWP 才有），
         这里显式定义，供 DashboardPage 等页面引用；运行期由 ThemeHelper.ApplyAccentColor 覆盖 -->
    <SolidColorBrush x:Key="SystemAccentColorDefaultBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="{StaticResource AppAccentColor}" Opacity="0.8" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="{StaticResource AppAccentColor}" Opacity="0.6" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="{StaticResource AppAccentColor}" Opacity="0.4" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="{StaticResource AppAccentColor}" />

</ResourceDictionary>
