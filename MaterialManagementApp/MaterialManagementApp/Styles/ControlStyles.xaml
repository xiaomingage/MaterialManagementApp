<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaterialManagementApp.Common">

    <!-- ============================================================ -->
    <!-- 卡片样式（微信 PC 风格）：小圆角 + 无边框 + 无重阴影，           -->
    <!-- 层次感完全依靠底色深浅区分，扁平干净。                           -->
    <!-- 用法：<Border Style="{StaticResource CardBorderStyle}">       -->
    <!-- ============================================================ -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- 数据卡片（工作台/设置页统计卡片）：与普通卡片同表面，稍大内边距 -->
    <Style x:Key="StatCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ============================================================ -->
    <!-- 普通按钮（微信式扁平简约）：小圆角、无边框、无厚重立体感。        -->
    <!-- 主按钮仍用系统 AccentButtonStyle（强调色实底，已扁平）。         -->
    <!-- ============================================================ -->
    <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ============================================================ -->
    <!-- 统计卡：统一使用 StatCardBorderStyle（Border 纯展示，不可点击）。 -->
    <!-- 悬停高亮由页面 PointerEntered/Exited 处理器切换底色实现。        -->
    <!-- ============================================================ -->
    <!-- 快捷入口磁贴（微信式）：白卡表面 + 彩色图标（页面提供），        -->
    <!-- 悬停/按下换卡片悬停底色（Duration=0 无过渡动画），扁平无边框。   -->
    <!-- 图标颜色由页面内 SymbolIcon.Foreground 决定，保留功能色辨识；    -->
    <!-- 文字用主文字色，整体与素雅基调统一，不再使用整面高饱和色块。     -->
    <!-- ============================================================ -->
    <Style x:Key="QuickActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppCardHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppCardHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- 弹窗全局样式：表面取 AppDialogBrush（透明度高于卡片，配合系统    -->
    <!-- 遮罩层保证弹窗文字清晰）+ 统一圆角（OverlayCornerRadius），      -->
    <!-- 阴影由系统 ContentDialog 默认模板提供。                          -->
    <!-- 所有页面代码 new 出来的 ContentDialog 自动生效。                -->
    <!-- ============================================================ -->
    <Style TargetType="ContentDialog">
        <Setter Property="Background" Value="{ThemeResource AppDialogBrush}" />
    </Style>

    <!-- ============================================================ -->
    <!-- 按钮全局微调：保持 WinUI 默认交互态，仅统一圆角与内边距        -->
    <!-- （圆角已由 ControlCornerRadius Token 控制，这里补充内边距）     -->
    <!-- ============================================================ -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

</ResourceDictionary>
